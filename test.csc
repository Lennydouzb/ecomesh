  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script><![CDATA[
/* Cooja headless capture: writes "sim_us mote_id serial_line" for the whole
 * mission, then exits. The timeout (ms) is patched in by the generator. */
TIMEOUT(5184000000, log.testOK());

while(true) {
  log.log(time + " " + id + " " + msg + "\n");
  YIELD();
}
]]></script>
      <active>true</active>
    </plugin_config>
  </plugin>
</simconf>
